---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  maxWidth?: string;
}

const { title, description, maxWidth = 'max-w-5xl' } = Astro.props;
---

<Layout title={title}>
  <div class="min-h-full bg-gradient-to-br from-slate-50 to-slate-100 p-6 sm:p-10">
    <main class:list={['mx-auto', maxWidth]}>
      <header class="mb-8 text-center">
        <h1 class="text-4xl font-bold text-slate-900">{title}</h1>
        <p class="mt-2 text-slate-600">{description}</p>
      </header>

      <div class="rounded-sm bg-white p-6 shadow-lg ring-1 ring-slate-200">
        <slot />
      </div>
    </main>
  </div>
</Layout>
