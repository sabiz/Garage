---
import ToolLayout from '../layouts/ToolLayout.astro';
import HashCompareComponent from '../components/hash-compare/HashCompare.vue';

export const tool = {
  name: 'Hash Compare',
  path: '/hash-compare',
  description: 'Calculate and compare hash values from two inputs.'
};
---

<ToolLayout title={tool.name} description={tool.description} maxWidth="max-w-6xl">
  <HashCompareComponent client:load />
</ToolLayout>
